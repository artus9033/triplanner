# LLM connector: any OpenAI-compatible API. Used for every LLM call.
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
# AMPL Community Edition licence. Optional: without it AMPL runs on its demo licence.
AMPLKEY_UUID=
# Password that gates the app and API. Required before opening any tunnel.
DEV_ACCESS_PASSWORD=
